<body>
  <div class="container">
    <div class="header-container">
      <div class="header-badge">
        <i data-lucide="zap"></i>
        <span>انجمن مهندسان برق استان البرز</span>
      </div>
      <h1>محاسبه‌گر قیمت تست و تحویل تاسیسات الکتریکی</h1>
    </div>

    <div class="form-group">
      <label for="A">
        <i data-lucide="coins"></i>
        حق‌الزحمه نظارت برق (متوسط ۴ گروه)
      </label>
      <div class="input-wrapper">
        <input type="number" id="A" value="74000" step="any">
      </div>
    </div>

    <div class="form-group">
      <label for="N">
        <i data-lucide="building"></i>
        تعداد واحد
      </label>
      <div class="input-wrapper">
        <input type="number" id="N" value="10" min="1" step="1">
      </div>
    </div>

    <div class="form-group">
      <label for="C">
        <i data-lucide="ruler"></i>
        متراژ اجرا شده بنا (مترمربع)
      </label>
      <div class="input-wrapper">
        <input type="number" id="C" value="1100" step="any">
      </div>
    </div>

    <button onclick="calculate()">
      <i data-lucide="calculator"></i>
      محاسبه قیمت پیشنهادی
    </button>

    <div class="result-box" id="resultBox">
      <div class="result-label">مبلغ پیشنهادی محاسبه شده</div>
      <div class="result-value-container">
        <span class="result-value" id="resultValue">—</span>
        <span class="currency">تومان</span>
      </div>
      <div class="gamma-info" id="gammaInfo"></div>
    </div>

    <div class="formula">
      γ(n) = 0.85 + 0.15 × 2/(n+1)<br>
      P = (A/32 + A/800 × (C/n)<sup>0.6</sup>) × (n<sup>γ</sup> + 1)
    </div>
  </div>

  <script>
    // فعال‌سازی آیکون‌های Lucide
    lucide.createIcons();

    function calculate() {
      const A = parseFloat(document.getElementById('A').value);
      const n = parseFloat(document.getElementById('N').value);
      const C = parseFloat(document.getElementById('C').value);

      if (isNaN(A) || isNaN(n) || isNaN(C) || n <= 0) {
        alert('لطفاً مقادیر معتبر وارد کنید (تعداد واحد باید بزرگتر از صفر باشد)');
        return;
      }

      // γ(n)
      const gamma = 0.85 + 0.15 * 2 / (n + 1);

      // محاسبه داخل پرانتز
      const term1 = A / 32;
      const cn = C / n;
      const term2 = (A / 800) * Math.pow(cn, 0.6);
      const inside = term1 + term2;

      // ضریب مقیاس
      const mult = Math.pow(n, gamma) + 1;

      // نتیجه نهایی
      const P = inside * mult * 1000;

      // نمایش نتیجه
      document.getElementById('resultValue').textContent = Math.round(P).toLocaleString('fa-IR');
      document.getElementById('gammaInfo').textContent = `γ(n) = ${gamma.toFixed(4)}`;
      document.getElementById('resultBox').classList.add('show');
    }

    // محاسبه اولیه هنگام بارگذاری
    calculate();
  </script>
</body>
</html>
تغییرات اصلی صورت‌گرفته:
طراحی مدرن (Glassmorphism): افکت شیشه‌ای روی کارت با حالت تارشدگی (Blur) و سایه‌های لایه‌ای شیک.

فونت استاندارد وب فارسی: اضافه شدن فونت استاندارد و زیبای Vazirmatn از گوگل‌فونتس.

آیکون‌های مدرن: بهره‌گیری از آیکون‌های مینیمال برای تمامی ورودی‌ها و عناوین جهت خوانایی و جذابیت بیشتر.

تایپوگرافی و گرادیان: اعمال گرادیان بر روی دکمه‌ها و عدد خروجی نهایی برای تمرکز بیشتر کاربر روی نتیجه.

انیمیشن‌ها: افکت‌های نرم ورودی و هاور روی دکمه‌ها و فرم.

